<Window x:Class="ClaudePermissionAssistant.App.LivePromptTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Live Prompt Test - Developer Tool" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Live Claude Prompt Test" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Developer tool for validating real Claude Code permission prompt detection"
                       Foreground="DarkGray" Margin="0,5,0,0"/>
            <TextBlock Text="⚠️ OBSERVATION ONLY - No automation execution"
                       Foreground="Red" FontWeight="Bold" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Step 1: Window Selection -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Step 1: Select Terminal Window" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Name="WindowComboBox" Grid.Column="0" Margin="0,0,10,0"
                              DisplayMemberPath="DisplayText" VerticalContentAlignment="Center"
                              SelectionChanged="WindowComboBox_SelectionChanged"/>
                    <Button Name="RefreshButton" Grid.Column="1" Content="Refresh Windows"
                            Width="130" Click="RefreshButton_Click"/>
                </Grid>

                <TextBlock Name="SelectedWindowInfo" Margin="0,10,0,0" Foreground="DarkGray"
                           Text="No window selected"/>
            </StackPanel>
        </Border>

        <!-- Step 2 & 3: Extract and Parse -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Name="ReadTextButton" Grid.Column="0" Content="Step 2: Read Terminal Text"
                    Height="35" Click="ReadTextButton_Click" IsEnabled="False"/>
            <Button Name="ParseButton" Grid.Column="2" Content="Step 3: Parse Claude Prompt"
                    Height="35" Click="ParseButton_Click" IsEnabled="False"/>
            <Button Name="ExportButton" Grid.Column="4" Content="Export Captured Prompt"
                    Height="35" Click="ExportButton_Click" IsEnabled="False"/>
        </Grid>

        <!-- Results Display -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Raw Text -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Raw TextPattern Output" FontWeight="Bold"
                               Margin="5" Background="LightGray" Padding="5"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="RawTextBlock" Margin="10" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right: Parser Results -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Parser Results" FontWeight="Bold"
                               Margin="5" Background="LightGray" Padding="5"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock Name="ResultsTextBlock" Margin="10" FontFamily="Consolas" FontSize="11"
                                   TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="4" BorderBrush="Gray" BorderThickness="0,1,0,0" Padding="5" Margin="0,10,0,0">
            <TextBlock Name="StatusTextBlock" Text="Ready. Select a window and click Read Terminal Text."
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
